# Copie este archivo como .env y ajuste los valores.
DJANGO_SECRET_KEY=cambie-esta-clave
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=visionguard
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=visionguard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Visión: índice de cámara (0, 1, ...) o ruta a un archivo de video
VG_FUENTE_VIDEO=0
VG_UMBRAL_LBPH=70
VG_CUADROS_CONFIRMACION=5
VG_ESPERA_SEGUNDOS=60
VG_MUESTRAS_POR_CAPTURA=20
